<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NexusGuard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nexus_bg</item>
        <item name="android:statusBarColor">@color/nexus_bg</item>
        <item name="android:navigationBarColor">@color/nexus_bg_raised</item>
    </style>

    <style name="Theme.NexusGuard.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nexus_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NexusGuard</item>
    </style>
</resources>
