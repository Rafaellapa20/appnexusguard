<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Escudo em gradiente Accent -> Accent2 -->
    <path
        android:pathData="M50,5 L88,17 V47 C88,72 71,88 50,96 C29,88 12,72 12,47 V17 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12"
                android:startY="5"
                android:endX="88"
                android:endY="96">
                <item android:offset="0.0" android:color="#FF7C5CF6" />
                <item android:offset="1.0" android:color="#FF22D3EE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Arco do velocímetro -->
    <path
        android:pathData="M27,62 A24,24 0 0,1 68,34"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Ponteiro do velocímetro -->
    <path
        android:pathData="M50,56 L64,40"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Centro do velocímetro -->
    <path
        android:pathData="M50,49 A7,7 0 1,1 50,63 A7,7 0 1,1 50,49 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
